# Скопируй в .env и заполни. .env в git не попадает.
# Используется helpers/config.js при запуске npm run test:e2e.

# URL сервиса jsagent (по умолчанию localhost:3366)
E2E_JSAGENT_URL=http://localhost:3366

# URL и bearer-токен craftgpt (LLM)
E2E_CRAFTGPT_URL=http://localhost:3020
E2E_CRAFTGPT_TOKEN=

# Порт mock-сервера botmediator+contextsearch (по умолчанию 9999)
# E2E_MOCK_PORT=9999
