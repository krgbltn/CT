<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram id="readings-main" name="1. Основной цикл"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1740" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="NOTE" value="СИНИЙ: сценарий&lt;br&gt;ЗЕЛЕНЫЙ: JS-контроллер&lt;br&gt;КРАСНЫЙ: ошибка / помощь&lt;br&gt;&lt;br&gt;Все process / next передают account_id и readings_step_id.&lt;br&gt;Счетчик попыток существует только в сценарии." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#fff9df;strokeColor=#b6a457;fontColor=#4d4320;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="400" height="190" as="geometry"/></mxCell><mxCell id="A" value="Выбран ЛС&lt;br&gt;account_id, номер, адрес&lt;br&gt;Идентификация и подтверждение завершены" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=50;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="650" y="30" width="320" height="95" as="geometry"/></mxCell><mxCell id="B" value="Вводная реплика один раз на ЛС" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="320" height="65" as="geometry"/></mxCell><mxCell id="C" value="Начнем прием?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="700" y="265" width="220" height="90" as="geometry"/></mxCell><mxCell id="INIT" value="Контроллер&lt;br&gt;readings_action = init" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e4f4e8;strokeColor=#44885b;fontColor=#173c25;" vertex="1" parent="1"><mxGeometry x="650" y="395" width="320" height="65" as="geometry"/></mxCell><mxCell id="RESULT" value="Результат&lt;br&gt;контроллера" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e4f4e8;strokeColor=#44885b;fontColor=#173c25;" vertex="1" parent="1"><mxGeometry x="700" y="510" width="220" height="110" as="geometry"/></mxCell><mxCell id="METER" value="Новая шкала: начать цикл попыток сценария.&lt;br&gt;Назвать услугу, последние 3 цифры, шкалу,&lt;br&gt;предыдущее показание" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="360" height="100" as="geometry"/></mxCell><mxCell id="READY" value="Готовы назвать&lt;br&gt;показание?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="95" y="655" width="250" height="95" as="geometry"/></mxCell><mxCell id="SKIP" value="Контроллер: skip_service = true&lt;br&gt;readings_action = process&lt;br&gt;Пропустить оставшиеся шкалы прибора" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e4f4e8;strokeColor=#44885b;fontColor=#173c25;" vertex="1" parent="1"><mxGeometry x="430" y="650" width="300" height="105" as="geometry"/></mxCell><mxCell id="TYPE" value="scale_type?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="95" y="825" width="250" height="90" as="geometry"/></mxCell><mxCell id="WHOLE" value="true&lt;br&gt;Запросить целую часть&lt;br&gt;до запятой" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="0" y="980" width="240" height="95" as="geometry"/></mxCell><mxCell id="DECIMAL" value="false&lt;br&gt;Запросить показание&lt;br&gt;с поддержкой дроби" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="300" y="980" width="270" height="95" as="geometry"/></mxCell><mxCell id="CONFIRM" value="Повторить current_new_reading.&lt;br&gt;Клиент подтвердил?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="95" y="1135" width="300" height="105" as="geometry"/></mxCell><mxCell id="CLEAR" value="Очистить&lt;br&gt;current_new_reading" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="0" y="1290" width="240" height="65" as="geometry"/></mxCell><mxCell id="PROCESS" value="Контроллер: readings_action = process&lt;br&gt;Проверить значение.&lt;br&gt;Если корректно - отправить шкалу" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e4f4e8;strokeColor=#44885b;fontColor=#173c25;" vertex="1" parent="1"><mxGeometry x="490" y="1135" width="340" height="105" as="geometry"/></mxCell><mxCell id="ACCEPT" value="Сценарий:&lt;br&gt;Показание этой шкалы принято" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="1120" y="490" width="300" height="80" as="geometry"/></mxCell><mxCell id="NEXT" value="Контроллер&lt;br&gt;readings_action = next" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e4f4e8;strokeColor=#44885b;fontColor=#173c25;" vertex="1" parent="1"><mxGeometry x="1120" y="650" width="300" height="70" as="geometry"/></mxCell><mxCell id="FIX" value="Статья исправления&lt;br&gt;ПОДРОБНО: лист 2" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;shape=process;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="1120" y="870" width="300" height="85" as="geometry"/></mxCell><mxCell id="ERROR" value="Техническая статья:&lt;br&gt;Не удалось подтвердить передачу.&lt;br&gt;Без автоматического повтора" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#fce5e5;strokeColor=#b65a5a;fontColor=#6b2222;" vertex="1" parent="1"><mxGeometry x="1510" y="490" width="300" height="105" as="geometry"/></mxCell><mxCell id="HELP" value="Существующий маршрут&lt;br&gt;помощи / оператора&lt;br&gt;с проверкой доступности" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=50;fillColor=#fce5e5;strokeColor=#b65a5a;fontColor=#6b2222;" vertex="1" parent="1"><mxGeometry x="1510" y="870" width="300" height="95" as="geometry"/></mxCell><mxCell id="FINISH" value="Финальная статья: итог по шкалам.&lt;br&gt;Не объявлять успех,&lt;br&gt;если передач не было" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="1120" y="1340" width="300" height="95" as="geometry"/></mxCell><mxCell id="OTHER" value="Другой&lt;br&gt;лицевой счет?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="700" y="1500" width="220" height="100" as="geometry"/></mxCell><mxCell id="ACCOUNT" value="Запросить номер ЛС.&lt;br&gt;Выполнить идентификацию" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="50" y="1500" width="350" height="80" as="geometry"/></mxCell><mxCell id="END" value="Завершение диалога" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=50;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="1110" y="1520" width="310" height="65" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="A" target="B"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="B" target="C"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-3" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="C" target="INIT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-4" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="C" target="OTHER"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="310"/><mxPoint x="1020" y="1550"/></Array></mxGeometry></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="INIT" target="RESULT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-6" value="ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="RESULT" target="METER"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="METER" target="READY"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-8" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="READY" target="TYPE"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-9" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="READY" target="SKIP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="SKIP" target="RESULT"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="630"/><mxPoint x="810" y="630"/></Array></mxGeometry></mxCell><mxCell id="edge-11" value="true" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="TYPE" target="WHOLE"><mxGeometry relative="1" as="geometry"></mxGeometry>