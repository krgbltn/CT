ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="FIX" target="TYPE"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="800"/><mxPoint x="220" y="800"/></Array></mxGeometry></mxCell><mxCell id="edge-24" value="Отказ / повторная ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="FIX" target="HELP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-25" value="Техническая ошибка" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="RESULT" target="ERROR"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="940" y="475"/><mxPoint x="1660" y="475"/></Array></mxGeometry></mxCell><mxCell id="edge-26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="ERROR" target="HELP"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-27" value="Очередь закончилась" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="RESULT" target="FINISH"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="565"/><mxPoint x="970" y="1385"/></Array></mxGeometry></mxCell><mxCell id="edge-28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="FINISH" target="OTHER"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-29" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="OTHER" target="ACCOUNT"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="ACCOUNT" target="A"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="-100" y="1540"/><mxPoint x="-100" y="75"/></Array></mxGeometry></mxCell><mxCell id="edge-31" value="Нет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source="OTHER" target="END"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="readings-correction" name="2. Исправление"><mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="NOTE" value="Ошибки исправляются внутри сценария.&lt;br&gt;Агент не получает и не считает попытки.&lt;br&gt;При исправлении не входить в блок новой шкалы: попытки не сбрасывать." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#fff9df;strokeColor=#b6a457;fontColor=#4d4320;" vertex="1" parent="1"><mxGeometry x="20" y="30" width="370" height="130" as="geometry"/></mxCell><mxCell id="INVALID" value="reading_status = invalid&lt;br&gt;Те же прибор и шкала; обновленный ID шага" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=50;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="370" height="90" as="geometry"/></mxCell><mxCell id="CODE" value="reading_error?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="575" y="180" width="260" height="90" as="geometry"/></mxCell><mxCell id="LOW" value="1&lt;br&gt;Меньше предыдущего показания" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="0" y="340" width="280" height="90" as="geometry"/></mxCell><mxCell id="HIGH" value="2&lt;br&gt;Превышен расход или максимум API" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="280" height="90" as="geometry"/></mxCell><mxCell id="FORMAT" value="3&lt;br&gt;Некорректный формат числа" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="640" y="340" width="280" height="90" as="geometry"/></mxCell><mxCell id="PRECISION" value="4&lt;br&gt;Слишком много дробных знаков" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="960" y="340" width="280" height="90" as="geometry"/></mxCell><mxCell id="SAY" value="Озвучить причину ошибки" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="520" y="500" width="370" height="65" as="geometry"/></mxCell><mxCell id="USED" value="Повторная попытка&lt;br&gt;уже использована?&lt;br&gt;Проверяет сценарий" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="555" y="630" width="300" height="120" as="geometry"/></mxCell><mxCell id="HELP" value="Существующий маршрут&lt;br&gt;помощи / оператора&lt;br&gt;с проверкой доступности" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=50;fillColor=#fce5e5;strokeColor=#b65a5a;fontColor=#6b2222;" vertex="1" parent="1"><mxGeometry x="1030" y="640" width="300" height="100" as="geometry"/></mxCell><mxCell id="ASK" value="Хотите изменить&lt;br&gt;показание?" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rhombus;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="575" y="830" width="260" height="100" as="geometry"/></mxCell><mxCell id="RETRY" value="Внутри сценария отметить использование повтора.&lt;br&gt;Очистить current_new_reading" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;rounded=1;arcSize=8;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="490" y="1010" width="430" height="95" as="geometry"/></mxCell><mxCell id="INPUT" value="Вернуться к вводу по scale_type на листе 1.&lt;br&gt;Получить значение и подтверждение.&lt;br&gt;Вызвать process с обновленным ID шага" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=15;spacing=10;shape=process;fillColor=#e8f0ff;strokeColor=#456da8;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="490" y="1180" width="430" height="110" as="geometry"/></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#66758a;endArrow=block;endFill=1;jettySize=auto;" edge="1" parent="1" source