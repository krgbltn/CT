<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device"><diagram id="readings-overview" name="Общая схема приема показаний"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="20" guides="1" page="1" pageScale="1" pageWidth="4900" pageHeight="3500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="СИГУРД | Общая схема приема показаний по всем приборам и шкалам" style="text;html=1;fontFamily=Arial;fontSize=38;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="4800" height="65" as="geometry" /></mxCell><mxCell id="legend" value="Синий: сценарий. Зеленый: JS. Красный: ошибка/помощь. Пунктир: продолжение не подтверждено скриншотами. Обновлено 30.10.2026." style="text;html=1;fontFamily=Arial;fontSize=20;align=left;" vertex="1" parent="1"><mxGeometry x="50" y="100" width="4800" height="50" as="geometry" /></mxCell><mxCell id="panel-0" value="" style="rounded=1;fillColor=#fafcfe;strokeColor=#d3dfeb;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1160" height="2420" as="geometry" /></mxCell><mxCell id="panel-title-0" value="1. Вход и идентификация" style="rounded=1;fillColor=#244968;strokeColor=#244968;fontColor=#ffffff;fontFamily=Arial;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="1160" height="64" as="geometry" /></mxCell><mxCell id="panel-1" value="" style="rounded=1;fillColor=#fafcfe;strokeColor=#d3dfeb;" vertex="1" parent="1"><mxGeometry x="1240" y="180" width="1160" height="2420" as="geometry" /></mxCell><mxCell id="panel-title-1" value="2. Общее подтверждение адреса и init" style="rounded=1;fillColor=#244968;strokeColor=#244968;fontColor=#ffffff;fontFamily=Arial;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="180" width="1160" height="64" as="geometry" /></mxCell><mxCell id="panel-2" value="" style="rounded=1;fillColor=#fafcfe;strokeColor=#d3dfeb;" vertex="1" parent="1"><mxGeometry x="2440" y="180" width="1160" height="2420" as="geometry" /></mxCell><mxCell id="panel-title-2" value="3. Прием текущей шкалы" style="rounded=1;fillColor=#244968;strokeColor=#244968;fontColor=#ffffff;fontFamily=Arial;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2440" y="180" width="1160" height="64" as="geometry" /></mxCell><mxCell id="panel-3" value="" style="rounded=1;fillColor=#fafcfe;strokeColor=#d3dfeb;" vertex="1" parent="1"><mxGeometry x="3640" y="180" width="1220" height="2420" as="geometry" /></mxCell><mxCell id="panel-title-3" value="4. Проверка, исправление и передача" style="rounded=1;fillColor=#244968;strokeColor=#244968;fontColor=#ffffff;fontFamily=Arial;fontSize=25;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3640" y="180" width="1220" height="64" as="geometry" /></mxCell><mxCell id="bottom-panel" value="" style="rounded=1;fillColor=#f8fafc;strokeColor=#d3dfeb;" vertex="1" parent="1"><mxGeometry x="40" y="2640" width="4820" height="720" as="geometry" /></mxCell><mxCell id="bottom-title" value="5. Итоги, другой ЛС, помощь и завершение" style="text;html=1;fontFamily=Arial;fontSize=24;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="2645" width="4740" height="50" as="geometry" /></mxCell><mxCell id="start" value="Вход в прием показаний" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="440" y="280" width="360" height="70" as="geometry" /></mxCell><mxCell id="period" value="День месяца&lt;br&gt;не позднее 25-го?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="410" width="320" height="140" as="geometry" /></mxCell><mxCell id="closed" value="Прием с 1-го по 25-е число.&lt;br&gt;Информационное&lt;br&gt;сообщение&lt;br&gt;и завершение звонка." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17.5;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="300" height="130" as="geometry" /></mxCell><mxCell id="D1" value="D" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="610" width="80" height="80" as="geometry" /></mxCell><mxCell id="prepare" value="Тема: передача показаний.&lt;br&gt;Очистить клиентский номер ЛС.&lt;br&gt;Задать агент сценариев и статью&lt;br&gt;результата." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="620" width="400" height="130" as="geometry" /></mxCell><mxCell id="phone" value="JS: идентификация по телефону.&lt;br&gt;Поиск ЛС и выбор адреса&lt;br&gt;внутри агента." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="820" width="400" height="120" as="geometry" /></mxCell><mxCell id="phone_ok" value="ЛС найден?&lt;br&gt;successful_identification" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="1000" width="320" height="140" as="geometry" /></mxCell><mxCell id="A1" value="A" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="1030" width="80" height="80" as="geometry" /></mxCell><mxCell id="knows" value="Клиент знает&lt;br&gt;номер ЛС?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="1210" width="320" height="140" as="geometry" /></mxCell><mxCell id="H1" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="1240" width="80" height="80" as="geometry" /></mxCell><mxCell id="L0" value="L" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="1420" width="80" height="80" as="geometry" /></mxCell><mxCell id="number" value="Очистить account_number_client.&lt;br&gt;Запросить цифровую часть&lt;br&gt;номера ЛС через анкету." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="1560" width="400" height="130" as="geometry" /></mxCell><mxCell id="num_confirm" value="Повторить номер.&lt;br&gt;Клиент подтвердил?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="1760" width="320" height="140" as="geometry" /></mxCell><mxCell id="num_prepare" value="next_article: результат поиска по ЛС.&lt;br&gt;Номер сохранить для агента." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="1980" width="400" height="100" as="geometry" /></mxCell><mxCell id="account" value="JS: идентификация по номеру ЛС.&lt;br&gt;Поиск и выбор адреса&lt;br&gt;внутри агента." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="420" y="2160" width="400" height="120" as="geometry" /></mxCell><mxCell id="account_ok" value="ЛС найден?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="460" y="2340" width="320" height="140" as="geometry" /></mxCell><mxCell id="A2" value="A" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="980" y="2370" width="80" height="80" as="geometry" /></mxCell><mxCell id="H2" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="160" y="2370" width="80" height="80" as="geometry" /></mxCell><mxCell id="A0" value="A" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="280" width="80" height="80" as="geometry" /></mxCell><mxCell id="has_account" value="Номер ЛС&lt;br&gt;заполнен?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1660" y="440" width="320" height="140" as="geometry" /></mxCell><mxCell id="missing_account" value="Показанная ветка:&lt;br&gt;сообщение «Нет&lt;br&gt;приборов…»&lt;br&gt;и завершение." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fbeeed;strokeColor=#ac6259;fontColor=#70382f;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1260" y="440" width="300" height="140" as="geometry" /></mxCell><mxCell id="D2" value="D" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="640" width="80" height="80" as="geometry" /></mxCell><mxCell id="warning" value="ЗАМЕЧАНИЕ К СКРИНШОТУ&lt;br&gt;Здесь приборы еще не&lt;br&gt;запрашивались.&lt;br&gt;Нужна нейтральная ошибка&lt;br&gt;определения ЛС.&lt;br&gt;Исправление пока не&lt;br&gt;подтверждено." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fff6df;strokeColor=#b09042;fontColor=#6e5423;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1260" y="820" width="320" height="180" as="geometry" /></mxCell><mxCell id="address_done" value="address_success&lt;br&gt;равен true?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1660" y="660" width="320" height="140" as="geometry" /></mxCell><mxCell id="address_text" value="«Ваш адрес {account_address}?&lt;br&gt;Скажите да или нет»." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="880" width="400" height="110" as="geometry" /></mxCell><mxCell id="address_yes" value="Адрес&lt;br&gt;подтвержден?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1660" y="1060" width="320" height="140" as="geometry" /></mxCell><mxCell id="address_decline" value="Отказ / непонятный ответ:&lt;br&gt;существующая ветка уточнения&lt;br&gt;другого ЛС или помощи.*" style="shape=process;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fff6df;strokeColor=#b09042;fontColor=#6e5423;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1260" y="1100" width="300" height="170" as="geometry" /></mxCell><mxCell id="L1" value="L" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1260" y="1360" width="80" height="80" as="geometry" /></mxCell><mxCell id="H3" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1460" y="1360" width="80" height="80" as="geometry" /></mxCell><mxCell id="intro" value="«Называю последние три цифры&lt;br&gt;номера&lt;br&gt;прибора и предыдущие показания.&lt;br&gt;Передавайте показания по&lt;br&gt;названному&lt;br&gt;прибору. Начнем?»" style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="1280" width="400" height="160" as="geometry" /></mxCell><mxCell id="begin" value="Начнем&lt;br&gt;прием?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1660" y="1520" width="320" height="140" as="geometry" /></mxCell><mxCell id="H4" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1360" y="1550" width="80" height="80" as="geometry" /></mxCell><mxCell id="init_command" value="Команда сценария:&lt;br&gt;readings_action = init" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="1740" width="400" height="80" as="geometry" /></mxCell><mxCell id="route_note" value="СОГЛАСОВАНО&lt;br&gt;Блок next_article убрать.&lt;br&gt;Статью «Запрос показаний»&lt;br&gt;задать в articles.input.&lt;br&gt;Применение изменения&lt;br&gt;еще не подтверждено." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fff6df;strokeColor=#b09042;fontColor=#6e5423;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2060" y="1740" width="300" height="240" as="geometry" /></mxCell><mxCell id="init" value="JS-контроллер: init.&lt;br&gt;Получить все ПУ и шкалы 4 услуг.&lt;br&gt;Убрать дубли ID; сохранить очередь." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1620" y="2080" width="400" height="120" as="geometry" /></mxCell><mxCell id="T1" value="T" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2200" y="2100" width="80" height="80" as="geometry" /></mxCell><mxCell id="Q0" value="Q" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="2280" width="80" height="80" as="geometry" /></mxCell><mxCell id="has_scale" value="Есть оставшаяся&lt;br&gt;шкала в очереди?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1660" y="2440" width="320" height="140" as="geometry" /></mxCell><mxCell id="R1" value="R" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2200" y="2470" width="80" height="80" as="geometry" /></mxCell><mxCell id="F1" value="F" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1360" y="2470" width="80" height="80" as="geometry" /></mxCell><mxCell id="R0" value="R" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2980" y="280" width="80" height="80" as="geometry" /></mxCell><mxCell id="ready" value="«Запрос показаний»: статус ready.&lt;br&gt;Новая шкала: начать цикл попыток.&lt;br&gt;Назвать услугу, последние 3 цифры&lt;br&gt;номера, шкалу и прошлое показание." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2820" y="440" width="400" height="170" as="geometry" /></mxCell><mxCell id="can_read" value="Готовы назвать&lt;br&gt;показание?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2860" y="680" width="320" height="140" as="geometry" /></mxCell><mxCell id="skip_command" value="Команда сценария:&lt;br&gt;skip_service = true&lt;br&gt;readings_action = process" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2460" y="680" width="320" height="140" as="geometry" /></mxCell><mxCell id="skip" value="JS: пропустить оставшиеся шкалы&lt;br&gt;этого прибора; переданные&lt;br&gt;сохранить.&lt;br&gt;Другие приборы услуги не&lt;br&gt;пропускать." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2460" y="920" width="320" height="160" as="geometry" /></mxCell><mxCell id="Q1" value="Q" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2580" y="1170" width="80" height="80" as="geometry" /></mxCell><mxCell id="I0" value="I" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2980" y="900" width="80" height="80" as="geometry" /></mxCell><mxCell id="integer" value="scale_type&lt;br&gt;равен true?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2860" y="1060" width="320" height="140" as="geometry" /></mxCell><mxCell id="whole" value="Запросить целую часть&lt;br&gt;показания до запятой." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2460" y="1350" width="320" height="110" as="geometry" /></mxCell><mxCell id="fraction" value="Запросить показание с&lt;br&gt;дробью.&lt;br&gt;Сказать «запятая»&lt;br&gt;в нужном месте." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3260" y="1350" width="320" height="130" as="geometry" /></mxCell><mxCell id="input" value="Сохранить строку&lt;br&gt;current_new_reading без потери дроби." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2820" y="1560" width="400" height="100" as="geometry" /></mxCell><mxCell id="repeat" value="«Вы назвали {current_new_reading}.&lt;br&gt;Верно? Скажите да или нет»." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2820" y="1740" width="400" height="110" as="geometry" /></mxCell><mxCell id="confirmed" value="Клиент&lt;br&gt;подтвердил?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2860" y="1920" width="320" height="140" as="geometry" /></mxCell><mxCell id="clear_input" value="Очистить введенное значение.&lt;br&gt;Та же шкала; это не пропуск." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2460" y="1920" width="320" height="120" as="geometry" /></mxCell><mxCell id="I1" value="I" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2580" y="2120" width="80" height="80" as="geometry" /></mxCell><mxCell id="process_command" value="Команда: readings_action = process.&lt;br&gt;Передать значение, GUID ЛС&lt;br&gt;и текущий readings_step_id." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2820" y="2150" width="400" height="130" as="geometry" /></mxCell><mxCell id="V1" value="V" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2980" y="2380" width="80" height="80" as="geometry" /></mxCell><mxCell id="transport_note" value="Сценарий не сравнивает дробные числа.&lt;br&gt;Текущий ID шага берется из ответа контроллера и возвращается без изменения.&lt;br&gt;Счетчик исправлений хранится только в сценарии." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fff6df;strokeColor=#b09042;fontColor=#6e5423;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2460" y="2470" width="1120" height="100" as="geometry" /></mxCell><mxCell id="V0" value="V" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4180" y="280" width="80" height="80" as="geometry" /></mxCell><mxCell id="valid" value="Показание&lt;br&gt;корректно?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4060" y="440" width="320" height="140" as="geometry" /></mxCell><mxCell id="rules" value="ПРОВЕРКИ В JS&lt;br&gt;Формат и допустимая точность.&lt;br&gt;Новое &amp;gt;= предыдущее.&lt;br&gt;Расход &amp;lt;= 100.&lt;br&gt;Новое &amp;lt;= максимума API.&lt;br&gt;Границы разрешены." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fff6df;strokeColor=#b09042;fontColor=#6e5423;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3660" y="280" width="300" height="260" as="geometry" /></mxCell><mxCell id="bad" value="reading_error: 1 - меньше;&lt;br&gt;2 - предел/расход; 3 - формат;&lt;br&gt;4 - точность. Сохранить шкалу&lt;br&gt;и ввод, обновить ID шага.&lt;br&gt;reading_status = invalid." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3660" y="660" width="300" height="200" as="geometry" /></mxCell><mxCell id="correction" value="Статья исправления.&lt;br&gt;Озвучить причину ошибки." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3660" y="940" width="300" height="110" as="geometry" /></mxCell><mxCell id="used" value="Повторная попытка&lt;br&gt;уже использована?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3680" y="1130" width="260" height="140" as="geometry" /></mxCell><mxCell id="H5" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3780" y="1330" width="80" height="80" as="geometry" /></mxCell><mxCell id="change" value="Хотите исправить&lt;br&gt;показание?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3680" y="1510" width="260" height="140" as="geometry" /></mxCell><mxCell id="H6" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3780" y="1740" width="80" height="80" as="geometry" /></mxCell><mxCell id="retry" value="В сценарии отметить повтор.&lt;br&gt;Очистить ввод, сохранить&lt;br&gt;шкалу&lt;br&gt;и обновленный ID шага.&lt;br&gt;Повторно в ready не входить." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3660" y="1900" width="300" height="170" as="geometry" /></mxCell><mxCell id="I2" value="I" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3780" y="2170" width="80" height="80" as="geometry" /></mxCell><mxCell id="sending" value="JS: сохранить sending.&lt;br&gt;SOAP: передать одну шкалу&lt;br&gt;по ее MDScaleID." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4020" y="660" width="400" height="130" as="geometry" /></mxCell><mxCell id="api_ok" value="API вернул 1?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4060" y="870" width="320" height="140" as="geometry" /></mxCell><mxCell id="T0" value="T" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4600" y="630" width="80" height="80" as="geometry" /></mxCell><mxCell id="technical" value="Техническая ошибка: отказ / unknown.&lt;br&gt;Статья: передача не подтверждена.&lt;br&gt;Без автоматического повтора." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fbeeed;strokeColor=#ac6259;fontColor=#70382f;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4460" y="830" width="400" height="160" as="geometry" /></mxCell><mxCell id="H7" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4620" y="1090" width="80" height="80" as="geometry" /></mxCell><mxCell id="sent" value="JS: сохранить sent.&lt;br&gt;Только после сохранения&lt;br&gt;reading_status = accepted." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4020" y="1110" width="400" height="130" as="geometry" /></mxCell><mxCell id="accepted" value="«Запрос показаний»: статус accepted.&lt;br&gt;«Показание по этой услуге,&lt;br&gt;окончанию номера и шкале принято»." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4020" y="1360" width="400" height="140" as="geometry" /></mxCell><mxCell id="next_command" value="После реплики об успехе:&lt;br&gt;readings_action = next" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4020" y="1600" width="400" height="100" as="geometry" /></mxCell><mxCell id="advance" value="JS: следующая непропущенная шкала.&lt;br&gt;Очистить ввод, ошибку, пропуск.&lt;br&gt;Сформировать новый ID шага." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4020" y="1800" width="400" height="140" as="geometry" /></mxCell><mxCell id="Q2" value="Q" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="4180" y="2050" width="80" height="80" as="geometry" /></mxCell><mxCell id="F0" value="F" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1780" y="2680" width="80" height="80" as="geometry" /></mxCell><mxCell id="summary" value="Финальная статья. Итог по шкалам:&lt;br&gt;переданы / пропущены / нет шкал.&lt;br&gt;При 0 передач не объявлять успех." style="shape=parallelogram;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1620" y="2820" width="400" height="140" as="geometry" /></mxCell><mxCell id="other" value="Другой&lt;br&gt;лицевой счет?" style="rhombus;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=17;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1660" y="3050" width="320" height="140" as="geometry" /></mxCell><mxCell id="L2" value="L" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="1380" y="3080" width="80" height="80" as="geometry" /></mxCell><mxCell id="D0" value="D" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1780" y="3260" width="80" height="80" as="geometry" /></mxCell><mxCell id="end" value="Завершение звонка" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#edf4fc;strokeColor=#426b95;fontColor=#183b59;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2040" y="3250" width="360" height="80" as="geometry" /></mxCell><mxCell id="H0" value="H" style="ellipse;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=22;fillColor=#ffffff;strokeColor=#5b6c80;fontColor=#263c53;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2980" y="2680" width="80" height="80" as="geometry" /></mxCell><mxCell id="help" value="Действующий маршрут помощи.&lt;br&gt;Тема «Магеллан», где предусмотрено.&lt;br&gt;Перевод routingagent / оператор." style="shape=process;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#eaf5ef;strokeColor=#477c60;fontColor=#264c37;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2820" y="2820" width="400" height="140" as="geometry" /></mxCell><mxCell id="help_outcomes" value="Дальнейший исход по действующим правилам:&lt;br&gt;соединение с оператором либо информация&lt;br&gt;о других способах передачи и завершение." style="shape=process;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fbeeed;strokeColor=#ac6259;fontColor=#70382f;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="2660" y="3070" width="720" height="150" as="geometry" /></mxCell><mxCell id="footnote" value="* Ветки отказов и лимитов анкет уточняются по крупным скриншотам.&lt;br&gt;Точное расписание доступности оператора остается в действующих маршрутах.&lt;br&gt;Скриншоты подтверждают настройку блоков, а не успешное исполнение на проде." style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;spacing=10;fontFamily=Arial;fontSize=18;fillColor=#fff6df;strokeColor=#b09042;fontColor=#6e5423;strokeWidth=2;dashed=1;dashPattern=9 6;" vertex="1" parent="1"><mxGeometry x="3660" y="2680" width="1180" height="190" as="geometry" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#65758a;strokeWidth=1.6;endArrow=block;endFill=1;exitX=.5;exitY=1;entryX=.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="start" target="period"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell><mxCell id="edge-1" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#65758a;strokeWidth=1.6;endArrow=block;endFill=1;exitX=0;exitY=.5;entryX=1;entryY=.5;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="period" target="closed"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="480" /></Array></mxGeometry></mxCell><mxCell id="label-1" value="Нет" style="text;html=1;fontFamily=Arial;fontSize=15;fillColor=#ffffff;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="400.9775390625" y="467.0" width="40.044921875" height="26" as="geometry" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=none;html=1;rounded=0;strokeColor=#65758a;strokeWidth=1.6;endArrow=block;endFill=1;exitX=.5;exitY=1;entryX=.5;entryY=0;exitPerimeter=1;entryPerimeter=1;" edge="1" parent="1" source="closed" target="D1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="200"